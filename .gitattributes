# Domyślnie: normalizuj końce linii, w kopii roboczej LF.
* text=auto eol=lf

# Skrypty powłoki MUSZĄ mieć LF (inaczej bash się wywala).
*.sh text eol=lf

# Skrypty Windows wygodniej z CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Pliki binarne — bez normalizacji końców linii.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.aes binary
